{
  "name": "paramele",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^2.5.4",
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "cross-env": "^7.0.3",
    "firebase": "^9.22.2",
    "framer-motion": "^6.5.1",
    "lodash": "^4.17.21",
    "plotly.js": "^2.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.7.1",
    "react-plotly.js": "^2.6.0",
    "react-scripts": "5.0.1",
    "reactflow": "^11.10.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "deploy": "npm run build && firebase deploy --only hosting --project paramele-prod",
    "deploy:rules": "firebase deploy --only firestore,storage --project paramele-prod",
    "deploy:cors": "gcloud storage buckets update gs://paramele-prod.firebasestorage.app --cors-file=cors.json --project=paramele-prod",
    "start": "cross-env BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "theme": "chakra-cli tokens src/theme.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@chakra-ui/cli": "^2.3.0"
  }
}
